<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:tag="layout/activity_flash_deliver_0" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include android:id="@id/layout_title" layout="@layout/common_toolbar" />
    <RelativeLayout android:tag="binding_1" android:background="@color/bg_net_not_wifi_tip" android:layout_width="fill_parent" android:layout_height="@dimen/len_40">
        <TextView android:textSize="@dimen/len_12" android:textColor="@color/bg_task_fail_red_point" android:tag="binding_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/apply_pad_common_left_right_15" android:layout_centerVertical="true" />
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/icon_close_pop" android:layout_alignParentRight="true" android:onClick="closeNetTip" />
    </RelativeLayout>
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/len_20">
        <RelativeLayout android:id="@id/rl_downloading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/apply_pad_common_left_right_15" android:onClick="clicShowList">
            <TextView android:id="@id/tv_downloading" android:tag="binding_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/file_upload_uploading" />
            <ImageView android:tag="binding_4" android:layout_below="@id/tv_downloading" android:layout_alignLeft="@id/tv_downloading" android:layout_alignRight="@id/tv_downloading" style="@style/task_center_indicator" />
        </RelativeLayout>
        <RelativeLayout android:id="@id/rl_failed" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/len_24" android:onClick="clicFailList">
            <TextView android:id="@id/tv_failed" android:tag="binding_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/common_status_failed" />
            <ImageView android:tag="binding_6" android:layout_below="@id/tv_failed" android:layout_alignLeft="@id/tv_failed" android:layout_alignRight="@id/tv_failed" style="@style/task_center_indicator" />
        </RelativeLayout>
    </LinearLayout>
    <androidx.viewpager.widget.ViewPager android:id="@id/view_pager" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginTop="@dimen/len_20" />
</LinearLayout>