<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="@dimen/len_50" />
            <solid android:color="@color/color_E4E4E4" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="@dimen/len_50" />
                <gradient android:startColor="@color/common_blue" android:endColor="@color/common_blue" android:angle="0.0" />
            </shape>
        </clip>
    </item>
</layer-list>