<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape android:shape="rectangle">
            <size android:height="@dimen/len_8" />
            <corners android:radius="@dimen/len_8" />
            <solid android:color="@color/color_E4E4E4" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="@dimen/len_8" />
                <corners android:radius="@dimen/len_8" />
                <solid android:color="@color/color_66C200" />
            </shape>
        </scale>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <size android:height="@dimen/len_8" />
                <corners android:radius="@dimen/len_8" />
                <solid android:color="@color/color_425FFF" />
            </shape>
        </scale>
    </item>
</layer-list>